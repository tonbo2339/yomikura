<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- アプリの更新: ダウンロードした APK のインストールを依頼する -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 裏での更新の確認: 新しい話の通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- オフライン保存 (OfflineService): 画面を消しても、別のアプリに移っても、キューの保存を続ける -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 端末の再起動後に、確認のアラームを掛け直す -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 決めた時刻どおりに確認する (Android 13 以降はこちら。ストア外のアプリはインストール時に許可される) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <!-- 「ほかのブラウザで開く」(MainActivity.openInBrowser) が、入っているブラウザを探すため -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appName}${appLabelSuffix}"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:usesCleartextTraffic="false">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- singleTask: ほかのアプリから URL を開いたときも、今の画面 (タブ) で開く (onNewIntent) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <!-- 対応サイトのリンクを開く。自分のドメインではないので検証 (autoVerify) はできず、
                 Android 12 以降はアプリ情報の「デフォルトで開く」で対応リンクを許可したときだけ直接開く -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="syosetu.com" />
                <data android:host="ncode.syosetu.com" />
                <data android:host="novel18.syosetu.com" />
                <data android:host="yomou.syosetu.com" />
                <data android:host="noc.syosetu.com" />
                <data android:host="mnlt.syosetu.com" />
                <data android:host="mid.syosetu.com" />
                <data android:host="syosetu.org" />
                <data android:host="h.syosetu.org" />
                <data android:host="kakuyomu.jp" />
            </intent-filter>

            <!-- 共有メニューから URL (を含むテキスト) を受け取る。こちらは許可なしで使える -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- ランチャーのアイコン。設定で選んだ 1 つだけを有効にする (MainActivity.setLauncherIcon) -->
        <activity-alias
            android:name=".IconGreen"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_green"
            android:roundIcon="@mipmap/ic_launcher_green_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_night"
            android:roundIcon="@mipmap/ic_launcher_night_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPaper"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOcean"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPurple"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSakura"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sakura"
            android:roundIcon="@mipmap/ic_launcher_sakura_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAiGold"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_aigold"
            android:roundIcon="@mipmap/ic_launcher_aigold_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconYuyake"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_yuyake"
            android:roundIcon="@mipmap/ic_launcher_yuyake_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMatcha"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_matcha"
            android:roundIcon="@mipmap/ic_launcher_matcha_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconDusk"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_dusk"
            android:roundIcon="@mipmap/ic_launcher_dusk_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconWood"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_wood"
            android:roundIcon="@mipmap/ic_launcher_wood_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSea"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_sea"
            android:roundIcon="@mipmap/ic_launcher_sea_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- オフライン保存の待ち行列を進める前景サービス (OfflineService.kt)。保存は画面外の WebView で行う -->
        <service
            android:name=".OfflineService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- 読み上げの通知・ロック画面の操作を支える前景サービス (ReadAloudService.kt)。読み上げ自体は画面側 (ReadAloud.kt) -->
        <service
            android:name=".ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- 裏での更新の確認 (BgCheck.kt): アラームの受け口と、画面に出さない WebView で巡回するジョブ -->
        <receiver
            android:name=".BgAlarmReceiver"
            android:exported="false" />
        <!-- 再起動・アプリの更新のあとはアラームを掛け直すだけ。システムのブロードキャストは exported=false でも届く (他のアプリからは呼べない) -->
        <receiver
            android:name=".BgBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".BgCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
